# Copy to .env.op and replace placeholders with your own 1Password references.
# .env.op is ignored by Git. These are references, never plaintext credentials.
CLOUDFLARE_API_TOKEN=op://YOUR_VAULT/YOUR_CLOUDFLARE_ITEM/api-token
CLOUDFLARE_ACCOUNT_ID=op://YOUR_VAULT/YOUR_CLOUDFLARE_ITEM/account-id
PUBLIC_TURNSTILE_SITE_KEY=op://YOUR_VAULT/YOUR_TURNSTILE_ITEM/site-key
TURNSTILE_SECRET_KEY=op://YOUR_VAULT/YOUR_TURNSTILE_ITEM/secret-key

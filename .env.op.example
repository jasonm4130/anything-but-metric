# Copy to .env.op and replace placeholders with your own 1Password references.
# .env.op is ignored by Git. These are references, never plaintext credentials.
CLOUDFLARE_API_TOKEN=op://YOUR_VAULT/YOUR_CLOUDFLARE_ITEM/api-token
CLOUDFLARE_ACCOUNT_ID=op://YOUR_VAULT/YOUR_CLOUDFLARE_ITEM/account-id
PUBLIC_TURNSTILE_SITE_KEY=op://YOUR_VAULT/YOUR_TURNSTILE_ITEM/site-key
TURNSTILE_SECRET_KEY=op://YOUR_VAULT/YOUR_TURNSTILE_ITEM/secret-key

# Jev through the gateway. `npm run secrets:sync` installs both as Worker secrets; the Jev suites of
# `npm run eval:live` use them too. The URL is not secret, but it carries the account ID.
# JEV_DECISIONS_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/anything-but-metric/custom-openrouter-api/api/alpha/decisions
# AI_GATEWAY_TOKEN=op://YOUR_VAULT/YOUR_AI_GATEWAY_ITEM/token
# OPENROUTER_API_KEY=op://YOUR_VAULT/YOUR_OPENROUTER_ITEM/api-key

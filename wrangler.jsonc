{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anything-but-metric",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "anythingbutmetric.wtf", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "limits": { "cpu_ms": 20 },
  "vars": { "AI_ENABLED": "true" },
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anything-but-metric",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "anythingbutmetric.wtf", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "limits": { "cpu_ms": 20 },
  "vars": { "AI_ENABLED": "true" },
  // Replay log of verified conversions; docs/deployment.md covers creating it for a new instance.
  "d1_databases": [{
    "binding": "REPLAY_LOG",
    "database_name": "anything-but-metric-replay",
    "database_id": "b2e21c1b-7d56-4e19-b868-43f3ba5b7862",
    "migrations_dir": "migrations"
  }],
  // Daily prune of replay rows past the 30-day retention window.
  "triggers": { "crons": ["17 3 * * *"] },
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }]
}

# Copy to .env.op and replace placeholders with your own 1Password references.
# .env.op is ignored by Git. These are references, never plaintext credentials.
# Anything But Metric deploy token, issued by the account's token stack.
TF_VAR_cloudflare_api_token=op://YOUR_VAULT/YOUR_DEPLOY_TOKEN_ITEM/api_token
# Independent state-encryption passphrase of at least 32 characters.
TF_VAR_state_passphrase=op://YOUR_VAULT/YOUR_STATE_PASSPHRASE_ITEM/passphrase
TF_VAR_openrouter_api_key=op://YOUR_VAULT/YOUR_OPENROUTER_ITEM/credential
# Not secrets, but instance-specific. The store ID must match the gateway's.
TF_VAR_cloudflare_account_id=YOUR_ACCOUNT_ID
TF_VAR_secrets_store_id=YOUR_SECRETS_STORE_ID
# State credential scoped to anything-but-metric's own state, issued by the
# account's token stack. Never the root Cloudflare Terraform R2 keys.
AWS_ACCESS_KEY_ID=op://YOUR_VAULT/YOUR_ABM_STATE_CREDENTIAL_ITEM/access_key_id
AWS_SECRET_ACCESS_KEY=op://YOUR_VAULT/YOUR_ABM_STATE_CREDENTIAL_ITEM/secret_access_key
